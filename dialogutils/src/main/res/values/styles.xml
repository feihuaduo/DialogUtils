<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
	<style name="dialog" parent="android:style/Theme.Dialog">
		<item name="android:windowBackground">@android:color/transparent</item>
		<!--是否模糊-->
		<item name="android:backgroundDimEnabled">true</item>	
	</style>

	<style name="dialog_button">
		<item name="android:gravity">center</item>
		<item name="android:background">@drawable/click_background</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textSize">@dimen/dialog_button_text_size</item>
		<item name="android:layout_height">@dimen/dialog_button_height</item>
		<item name="android:textColor">@color/colorAccent</item>
	</style>

	<style name="dialog_title">
		<item name="android:textIsSelectable">true</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:textSize">@dimen/dialog_title_size</item>
		<item name="android:id" tools:ignore="AaptCrash">@+id/tv_title</item>
		<item name="android:textColor">#000000</item>
		<item name="android:textStyle">bold</item>
		<item name="android:layout_marginTop">10dp</item>
		<item name="android:layout_marginBottom">6dp</item>
		<item name="android:layout_marginLeft">10dp</item>
		<item name="android:layout_marginRight">10dp</item>
		<item name="android:gravity">center</item>
		<item name="android:layout_gravity">center_horizontal</item>
	</style>


	<style name="progressBarStyle">

	</style>

	<!-- FDialogBottomSheet edge-to-edge（全面屏沉浸）主题，与宿主 OYBottomSheetDialog 同构：
	     enableEdgeToEdge 让 Material onAttachedToWindow 自动完成 decorFits/fitsSystemWindows 切换；
	     导航栏透明让 sheet 白底延伸到手势条下方（状态栏由 BottomSheetDialog.onCreate 无条件置透明，
	     无需声明 statusBarColor）。bottomSheetStyle 指向透明 Modal 样式，关闭 M2 链默认的
	     padding*SystemWindowInsets（顶部黑带/底部间隔的根因） -->
	<style name="bottomSheetDialogStyle" parent="Theme.MaterialComponents.BottomSheetDialog">
		<!-- 关键：M2 BottomSheetDialog 主题链继承 Theme.AppCompat.Dialog 的 windowIsFloating=true，
		     floating 窗口内容被包裹、强制避让系统栏（底部差一条手势条高度），
		     setDecorFitsSystemWindows(false) 对它无效。M3 主题链显式设了 false，
		     这里必须同样声明才能让窗口延伸到系统栏下方 -->
		<item name="android:windowIsFloating">false</item>
		<item name="enableEdgeToEdge">true</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="bottomSheetStyle">@style/Widget.DialogUtils.BottomSheet.Modal</item>
	</style>

	<!-- sheet 容器透明：白色圆角背景唯一来源是内容根布局，避免滑出时露出杂色框。
	     backgroundTint 必须显式置透明：M2 链 Widget.MaterialComponents.BottomSheet 声明
	     backgroundTint=?attr/colorSurface 且被本样式继承，behavior 读到它会程序化创建
	     MaterialShapeDrawable 覆盖 android:background；而 Theme.MaterialComponents.BottomSheetDialog
	     是暗色链（colorSurface 为深灰），不置透明 sheet 就是黑底（宿主 .Top 模式同款修法）。
	     四个 padding*SystemWindowInsets 必须显式关闭：M2 链默认全 true，
	     会给 sheet 加状态栏顶部 padding（黑带）和手势条底部 padding（底部间隔），
	     insets 避让统一由内容根布局的 fitContentInsets 处理 -->
	<style name="Widget.DialogUtils.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
		<item name="backgroundTint">@android:color/transparent</item>
		<item name="android:background">@android:color/transparent</item>
		<item name="paddingTopSystemWindowInsets">false</item>
		<item name="paddingBottomSystemWindowInsets">false</item>
		<item name="paddingLeftSystemWindowInsets">false</item>
		<item name="paddingRightSystemWindowInsets">false</item>
	</style>

</resources>
